/* ===== CPR метроном ===== */
let metroTimer=null,actx=null;
function beep(){
  try{
    actx=actx||new (window.AudioContext||window.webkitAudioContext)();
    const o=actx.createOscillator(),g=actx.createGain();
    o.frequency.value=880;g.gain.value=0.25;o.connect(g);g.connect(actx.destination);
    o.start();o.stop(actx.currentTime+0.06);
  }catch(e){}
}
function tick(){
  beep();if(navigator.vibrate)navigator.vibrate(40);
  const b=$('#beat');b.classList.add('on');setTimeout(()=>b.classList.remove('on'),90);
}
function startMetro(){
  const bpm=+$('#bpmRange').value;
  tick();metroTimer=setInterval(tick,60000/bpm);
  $('#btnMetro').textContent='⏹ Тоқтату';
}
function stopMetro(){
  if(metroTimer){clearInterval(metroTimer);metroTimer=null}
  const b=$('#btnMetro');if(b)b.textContent='▶ Бастау';
}
$('#btnMetro').onclick=()=>metroTimer?stopMetro():startMetro();
$('#bpmRange').oninput=e=>{$('#bpm').textContent=e.target.value;if(metroTimer){stopMetro();startMetro()}};


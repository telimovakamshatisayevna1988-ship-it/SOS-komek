let filter='all';
function renderChips(){
  const opts=[['all','Барлығы'],['r','🔴 Шұғыл'],['y','🟡 Маңызды'],['g','🟢 Жеңіл']];
  $('#chips').innerHTML=opts.map(o=>`<button class="chip ${filter===o[0]?'on':''}" data-f="${o[0]}">${o[1]}</button>`).join('');
  $$('#chips .chip').forEach(c=>c.onclick=()=>{filter=c.dataset.f;renderChips();renderList()});
}
function renderList(){
  const q=$('#q').value.trim().toLowerCase();
  const items=GUIDES.filter(g=>(filter==='all'||g.u===filter)&&(!q||g.t.toLowerCase().includes(q)||g.sym.join(' ').toLowerCase().includes(q)));
  $('#list').innerHTML=items.length?items.map(g=>`<button class="item" data-id="${g.id}"><span class="e">${g.e}</span><span class="t">${esc(g.t)}</span><span class="tag ${URG[g.u].c}">${URG[g.u].t}</span></button>`).join(''):'<p class="muted">Ештеңе табылмады.</p>';
  $$('#list .item').forEach(b=>b.onclick=()=>openGuide(b.dataset.id));
}
$('#q').oninput=renderList;

function sec(cls,title,arr,ordered){
  if(!arr||!arr.length)return '';
  const tag=ordered?'ol':'ul';
  return `<div class="sec ${cls}"><h3>${title}</h3><${tag}>${arr.map(x=>`<li>${esc(x)}</li>`).join('')}</${tag}></div>`;
}
let currentGuide=null;
function openGuide(id){
  const g=GUIDES.find(x=>x.id===id);currentGuide=g;
  $('#detail').innerHTML=`
    <h2 style="margin:0 0 4px">${g.e} ${esc(g.t)} <span class="tag ${URG[g.u].c}">${URG[g.u].t}</span></h2>
    <a class="btn red" href="tel:112">📞 112-ге қоңырау шалу</a>
    <button class="btn gray" id="btnSpeak">🔊 Дауыстап оқу</button>
    ${sec('sym','Белгілері',g.sym,false)}
    ${sec('do','Не істеу керек',g.do,true)}
    ${sec('dont','Не істеуге болмайды',g.dont,false)}
    ${sec('call','Қашан 112/103-ке қоңырау шалу керек',g.call,false)}
    <p class="warn">Ақпарат жалпы мақсатта берілген және дәрігер көмегін алмастырмайды.</p>`;
  $('#btnSpeak').onclick=speakGuide;
  go('detail');
}
function speakGuide(){
  if(!('speechSynthesis' in window)){toast('Бұл құрылғы дауыспен оқуды қолдамайды');return}
  if(speechSynthesis.speaking){speechSynthesis.cancel();return}
  const g=currentGuide;
  const text=g.t+'. Не істеу керек. '+g.do.map((x,i)=>(i+1)+'. '+x).join(' ')+' Не істеуге болмайды. '+(g.dont||[]).join(' ');
  const u=new SpeechSynthesisUtterance(text);
  const voices=speechSynthesis.getVoices();
  const v=voices.find(v=>/^kk/i.test(v.lang))||voices.find(v=>/^ru/i.test(v.lang));
  if(v){u.voice=v;u.lang=v.lang}else{u.lang='kk-KZ'}
  if(!voices.some(v=>/^kk/i.test(v.lang)))toast('Қазақша дауыс табылмады, ең жақын дауыс қолданылады');
  speechSynthesis.speak(u);
}

/* ===== Орын және SOS ===== */
let lastLoc=null;
function locText(){
  if(!lastLoc)return 'Көмек керек! Орнымды анықтай алмадым.';
  const {latitude:la,longitude:lo,accuracy:ac}=lastLoc.coords;
  const link=`https://maps.google.com/?q=${la.toFixed(6)},${lo.toFixed(6)}`;
  const med=store.get('med',{});
  const extra=[med.blood&&('Қан тобы: '+med.blood),med.allergy&&('Аллергия: '+med.allergy)].filter(Boolean).join('. ');
  return `🆘 Көмек керек! Менің орным: ${link} (дәлдігі шамамен ${Math.round(ac)} м).${extra?' '+extra+'.':''}`;
}
function buildSendButtons(){
  const cs=store.get('contacts',[]);
  const msg=encodeURIComponent(locText());
  if(!cs.length){
    $('#sendBox').innerHTML='<p class="muted">Жақындарға жіберу үшін «Менің» бөлімінде сенімді адамдарды қосыңыз.</p><a class="btn green" href="sms:?&body='+msg+'">💬 SMS арқылы жіберу</a>';
    return;
  }
  $('#sendBox').innerHTML=cs.map(c=>{
    const ph=c.phone.replace(/[^\d+]/g,'');
    const wa=ph.replace(/\D/g,'');
    return `<a class="btn green" href="sms:${ph}?&body=${msg}">💬 ${esc(c.name)}: SMS</a><a class="btn" style="background:#128c7e" href="https://wa.me/${wa}?text=${msg}" target="_blank" rel="noopener">WhatsApp: ${esc(c.name)}</a>`;
  }).join('');
}
function getLocation(){
  $('#locStatus').textContent='📍 Орын анықталуда…';
  if(!navigator.geolocation){$('#locStatus').textContent='⚠️ Бұл құрылғы орынды анықтамайды. Мекенжайды дауыспен айтыңыз.';buildSendButtons();return}
  navigator.geolocation.getCurrentPosition(pos=>{
    lastLoc=pos;
    const {latitude:la,longitude:lo,accuracy:ac}=pos.coords;
    $('#locStatus').innerHTML=`📍 Орныңыз анықталды (дәлдігі ~${Math.round(ac)} м)<br><a href="https://maps.google.com/?q=${la},${lo}" target="_blank" rel="noopener">Картада көру</a>`;
    buildSendButtons();
  },err=>{
    const m=err.code===1?'Орынға рұқсат берілмеді. Браузер баптауынан рұқсат беріңіз.':'Орын анықталмады.';
    $('#locStatus').textContent='⚠️ '+m+' Мекенжайды дауыспен айтыңыз.';
    buildSendButtons();
  },{enableHighAccuracy:true,timeout:12000,maximumAge:0});
}
$('#btnSOS').onclick=()=>{
  if(navigator.vibrate)navigator.vibrate(200);
  $('#panelSOS').style.display='block';
  $('#panelSOS').scrollIntoView({behavior:'smooth'});
  getLocation();
};
$('#btnCopyLoc').onclick=async()=>{
